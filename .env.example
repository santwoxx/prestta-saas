# ---------------------------------------------------------------------------
# Prestta - variaveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# ---------------------------------------------------------------------------

PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Segredo usado para assinar os tokens de sessao.
# Em producao e OBRIGATORIO ter 32+ caracteres aleatorios (o servidor recusa
# subir com o valor de exemplo). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=troque-este-segredo-em-producao

# Dias de teste gratis concedidos no cadastro
TRIAL_DAYS=14

# Dias de acesso mantido depois que a cobranca falha, antes de pausar a conta.
# 0 = bloqueia assim que a Cakto avisa que o pagamento nao passou.
GRACE_DAYS=7

# ---------------------------------------------------------------------------
# E-mails transacionais (boas-vindas, trial acabando, cobranca)
# ---------------------------------------------------------------------------
# Sem MAIL_API_KEY o sistema roda em modo "log": o e-mail aparece no console e
# fica gravado em email_log com status "simulado". Nada quebra.
#
#   resend -> https://resend.com  (3.000 e-mails/mes no plano gratuito)
#   brevo  -> https://brevo.com   (300 e-mails/dia no plano gratuito)
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=nao-responda@seudominio.com.br
MAIL_FROM_NAME=Prestta
MAIL_REPLY_TO=

# Desliga a regua de cobranca automatica (avisos de trial e de atraso).
# DISABLE_JOBS=1

# ---------------------------------------------------------------------------
# Persistencia
# ---------------------------------------------------------------------------
# Onde ficam o banco SQLite e os arquivos enviados (fotos e assinaturas).
# Em desenvolvimento pode deixar vazio (usa ./data e ./public/uploads).
# Em producao aponte para um VOLUME PERSISTENTE, ex.: /data/db e /data/uploads.
# DATA_DIR=/data/db
# UPLOAD_DIR=/data/uploads

# ---------------------------------------------------------------------------
# Firebase (usado apenas para validar o login com Google)
# ---------------------------------------------------------------------------
# Project ID do seu projeto no Firebase Console.
FIREBASE_PROJECT_ID=prestta

# ---------------------------------------------------------------------------
# Superadmin do SaaS (painel /saas: contas, MRR, leads, webhooks)
# ---------------------------------------------------------------------------
# Use o MESMO e-mail da sua conta Google. Depois rode: npm run bootstrap
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=Administrador

# ---------------------------------------------------------------------------
# Integracao Cakto (https://app.cakto.com.br -> Ferramentas -> Cakto API)
# ---------------------------------------------------------------------------
# Chave de API (Bearer). Sem ela o sistema usa apenas os links de checkout.
CAKTO_API_KEY=
CAKTO_API_BASE=https://api.cakto.com.br

# Segredo do webhook (campo "secret" no corpo OU header x-cakto-signature).
# OBRIGATORIO em producao: sem ele qualquer pessoa poderia ativar uma
# assinatura de graca chamando o endpoint do webhook.
CAKTO_WEBHOOK_SECRET=

# Links de checkout de cada plano (copiados do painel da Cakto).
# Aceita tanto a URL completa quanto apenas o codigo da oferta.
CAKTO_CHECKOUT_ESSENCIAL_MENSAL=
CAKTO_CHECKOUT_ESSENCIAL_ANUAL=
CAKTO_CHECKOUT_PRO_MENSAL=
CAKTO_CHECKOUT_PRO_ANUAL=
CAKTO_CHECKOUT_ESCALA_MENSAL=
CAKTO_CHECKOUT_ESCALA_ANUAL=

# IDs de oferta da Cakto (opcional) - usados para casar o webhook com o plano.
CAKTO_OFFER_ESSENCIAL=
CAKTO_OFFER_PRO=
CAKTO_OFFER_ESCALA=
